#cloud-config

package_update: true
package_upgrade: false

packages:
  - git
  - curl
  - firewalld
  - dnf-plugins-core

write_files:
  - path: /tmp/traefik-compose.yml
    owner: root:root
    permissions: '0644'
    encoding: b64
    content: ${traefik_compose_b64}
%{ if registry_enabled ~}
  - path: /tmp/install-ocir-helper.sh
    owner: root:root
    permissions: '0700'
    encoding: b64
    content: ${registry_helper_b64}
%{ endif ~}
%{ if deployment_enabled ~}
  - path: /usr/local/sbin/deploy-compose-app
    owner: root:root
    permissions: '0755'
    encoding: b64
    content: ${deployment_wrapper_b64}
  - path: /etc/sudoers.d/101-oracle-cloud-agent-deploy
    owner: root:root
    permissions: '0440'
    content: |
      Defaults!/usr/local/sbin/deploy-compose-app env_reset,secure_path=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
      ocarun ALL=(root) NOPASSWD: /usr/local/sbin/deploy-compose-app
%{ endif ~}

runcmd:
  - dnf config-manager --add-repo https://download.docker.com/linux/centos/docker-ce.repo

  - dnf -y install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

  - dnf -y install oraclelinux-developer-release-el9
  - dnf -y install python39-oci-cli

  - systemctl enable --now docker
  - systemctl enable --now firewalld

  - usermod -aG docker opc
%{ if registry_enabled ~}
  - /tmp/install-ocir-helper.sh
  - rm -f /tmp/install-ocir-helper.sh
%{ endif ~}
%{ if deployment_enabled ~}
  - install -d -o root -g root -m 0750 /etc/docker-platform
  - install -d -o root -g root -m 0750 /etc/docker-platform/apps
  - visudo -cf /etc/sudoers.d/101-oracle-cloud-agent-deploy
  - systemctl enable --now oracle-cloud-agent
%{ endif ~}

  - firewall-cmd --permanent --add-service=ssh
  - firewall-cmd --permanent --add-service=http
  - firewall-cmd --permanent --add-service=https
  - firewall-cmd --reload

  - mkdir -p /opt/apps/proxy/letsencrypt
  - mkdir -p /opt/apps/shared
  - mkdir -p /opt/apps/apps

  - mv /tmp/traefik-compose.yml /opt/apps/proxy/docker-compose.yml

  - touch /opt/apps/proxy/letsencrypt/acme.json
  - chmod 600 /opt/apps/proxy/letsencrypt/acme.json

  - chown -R opc:opc /opt/apps
%{ if deployment_enabled ~}
  - chown root:root /opt/apps/apps
  - chmod 0750 /opt/apps/apps
%{ endif ~}

  - docker network inspect proxy >/dev/null 2>&1 || docker network create proxy

  - cd /opt/apps/proxy && docker compose up -d
