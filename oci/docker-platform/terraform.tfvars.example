# Identidad OCI
tenancy_ocid     = "ocid1.tenancy.oc1..REEMPLAZAR"
compartment_ocid = "ocid1.compartment.oc1..REEMPLAZAR"
compartment_name = "mi-compartment"

# Proyecto
project_name = "mi-proyecto"

# Región
region                  = "sa-saopaulo-1"
oci_auth                = "InstancePrincipal"
oci_config_file_profile = "DEFAULT"

# En OCI Cloud Shell, crea un perfil de sesión y utiliza:
# oci_auth                = "SecurityToken"
# oci_config_file_profile = "TERRAFORM"
#
# La configuración del backend remoto no pertenece a este archivo.
# Usa backend.oci.tfbackend (ignorado por Git).

# Compute
ocpus         = 2
memory_in_gbs = 12

# Networking
vcn_cidr           = "10.20.0.0/16"
public_subnet_cidr = "10.20.1.0/24"

# SSH
ssh_public_key_path = "~/.ssh/cloudshellkey.pub"
ssh_source_cidr     = "0.0.0.0/0"

# HTTPS
acme_email = "tu-email@example.com"

# Opcional:
# image_ocid = "ocid1.image..."

# Object Storage
# Si se deja comentado se utilizará: <project_name>-media
# media_bucket_name = "mi-proyecto-media"

# Opciones:
# NoPublicAccess
# ObjectReadWithoutList
# ObjectRead
object_storage_access_type = "NoPublicAccess"

# El versionado puede aumentar el consumo de almacenamiento.
object_storage_versioning = false

# Lifecycle del bucket media. Todas las acciones están deshabilitadas por defecto.
object_storage_lifecycle_enabled = false

# Configura únicamente las reglas necesarias con un número entero de días.
# Archivar objetos puede generar costos de recuperación y afectar su disponibilidad.
object_storage_archive_after_days = null

# Requiere object_storage_versioning = true y elimina datos de forma irreversible.
object_storage_delete_previous_versions_after_days = null

# Aborta únicamente cargas multipart que nunca se completaron.
object_storage_abort_multipart_uploads_after_days = null

# Backup del boot volume. Deshabilitado por defecto para evitar costos inesperados.
backup_enabled = false

backup_frequency      = "WEEKLY"
backup_type           = "INCREMENTAL"
backup_retention_days = 28
backup_hour_utc       = 2

# Solo se utilizan para la frecuencia correspondiente.
backup_day_of_week  = "SUNDAY"
backup_day_of_month = 1

# Observabilidad
# Al habilitarla, notification_endpoint es obligatorio.
monitoring_enabled = false

# El nombre debe ser único en la tenancy. null utiliza: <project_name>-alerts
notification_topic_name = null

# Protocolos: EMAIL, CUSTOM_HTTPS, ORACLE_FUNCTIONS, PAGERDUTY, SLACK o SMS
notification_protocol = "EMAIL"
notification_endpoint = null

cpu_alarm_threshold_percent        = 80
cpu_alarm_pending_duration_minutes = 5
cpu_alarm_severity                 = "WARNING"
